{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/Eto.Veldrid.sln",
                "-c:${input:configuration}",
                "-clp:NoSummary",
                "/p:GenerateFullPaths=true",
            ],
            "linux": {
                "args": [
                    "build",
                    "${workspaceFolder}/test/TestEtoVeldrid.Gtk/TestEtoVeldrid.Gtk.csproj",
                    "-c:${input:configuration}",
                    "-clp:NoSummary",
                    "/p:GenerateFullPaths=true",
                    ]
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "clear": true
            },
        },
        {
            "label": "Pack",
            "command": "dotnet",
            "type": "process",
            "args": [
                "pack",
                "${workspaceFolder}/Eto.Veldrid.sln",
                "-c:${input:configuration}",
                "/p:GenerateFullPaths=true",
                "-clp:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "clear": true
            },
        }
    ],
    "inputs": [
        {
            "description": "Configuration",
            "type": "pickString",
            "id": "configuration",
            "default": "Debug",
            "options": [
                "Debug",
                "Release"
            ]
        }
    ]
}
